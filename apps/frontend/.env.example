# =============================================================================
# Frontend (Vite / Cloudflare Pages SPA build)
# =============================================================================
# Copy to:
#   apps/frontend/.env.development   (local dev)
#   apps/frontend/.env.production    (prod build)
# Or set in Cloudflare Pages → Settings → Environment variables (Build & deploy).
#
# IMPORTANT: every VITE_* variable is bundled into the client and PUBLIC.
# Never put secrets here. Server-only secrets belong in the Supabase or
# Cloudflare Pages Functions env files.
# =============================================================================

# --- Supabase (public) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- App URLs ---
VITE_APP_URL=http://localhost:5173
VITE_PUBLIC_PROFILE_BASE_URL=http://localhost:5173

# --- Captcha (recruiter contact form) ---
VITE_CAPTCHA_PROVIDER=hcaptcha            # hcaptcha | turnstile
VITE_CAPTCHA_SITE_KEY=

# --- Feature flags (UI) ---
VITE_ENABLE_PUBLIC_CHAT=true
VITE_ENABLE_JOB_FIT=true
VITE_ENABLE_AVATAR_FOUNDATION=false
VITE_ENABLE_CITATIONS=true
VITE_ENABLE_VOICE=false

# --- Auth providers visible on /login ---
VITE_AUTH_GOOGLE_ENABLED=true
VITE_AUTH_GITHUB_ENABLED=true
VITE_AUTH_APPLE_ENABLED=false
VITE_AUTH_MAGIC_LINK_ENABLED=true

# --- Observability (optional) ---
VITE_SENTRY_DSN=
VITE_APP_VERSION=0.1.0
