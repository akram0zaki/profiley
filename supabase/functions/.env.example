# =============================================================================
# Supabase Edge Functions — server-only secrets (TEMPLATE)
# =============================================================================
# Copy this file twice, once per environment, and fill in real values:
#   cp supabase/functions/.env.example supabase/functions/.env.development
#   cp supabase/functions/.env.example supabase/functions/.env.production
# Both copies are gitignored.
#
# Apply to the matching Supabase project:
#   set -a && source supabase/.env && set +a
#   supabase secrets set --project-ref "$SUPABASE_PROJECT_REF_DEV" \
#                      --env-file supabase/functions/.env.development
#   supabase secrets set --project-ref "$SUPABASE_PROJECT_REF_PROD" \
#                      --env-file supabase/functions/.env.production
#
# NEVER expose these to the browser. SUPABASE_URL / SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY / SUPABASE_DB_URL / SUPABASE_JWT_SECRET are
# auto-injected by the Supabase runtime in production but are listed here
# so local `supabase functions serve` can run with one of these files.
# =============================================================================

# --- Supabase platform (auto-injected in production; needed for local serve) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_JWT_SECRET=super-long-jwt-secret
SUPABASE_DB_URL=postgresql://postgres:password@localhost:54322/postgres

# --- AI providers ---
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=
OPENAI_BASE_URL=https://api.openai.com/v1

GOOGLE_GEMINI_API_KEY=
MISTRAL_API_KEY=

# Optional / post-MVP providers
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
SYNTHESIA_API_KEY=

# --- Default model identifiers (override seeded ai_provider_configs) ---
DEFAULT_CHAT_MODEL=openai:gpt-4o-mini
DEFAULT_JOB_FIT_MODEL=openai:gpt-4o
DEFAULT_EMBEDDING_MODEL=openai:text-embedding-3-small
DEFAULT_MODERATION_MODEL=openai:omni-moderation-latest
DEFAULT_STT_MODEL=openai:whisper-1
DEFAULT_TTS_MODEL=openai:tts-1

# --- Email (Resend) for recruiter contact ---
RESEND_API_KEY=re_...
# Sender used by submit-recruiter-contact (must match a domain verified in Resend)
RECRUITER_EMAIL_FROM=noreply@profiley.ai
RECRUITER_EMAIL_FROM_NAME=Profiley
# Optional: Reply-To header default
RESEND_REPLY_TO_DEFAULT=noreply@profiley.ai

# --- Captcha verification (server-side counterpart to VITE_CAPTCHA_*) ---
# Code reads HCAPTCHA_SECRET (not HCAPTCHA_SECRET_KEY).
HCAPTCHA_SECRET=
TURNSTILE_SECRET_KEY=

# --- Rate limiting / abuse ---
VISITOR_SESSION_HMAC_SECRET=replace-with-32+chars-random
RATE_LIMIT_CHAT_PER_HOUR_PER_SESSION=20
RATE_LIMIT_CHAT_PER_HOUR_PER_IP=60
RATE_LIMIT_JOB_FIT_PER_HOUR_PER_SESSION=5
RATE_LIMIT_CONTACT_PER_DAY_PER_IP=3

# --- pg_cron → process-document shared secret ---
# Must match the `cron_secret` row in `public.runtime_settings`
# (see profiley-init-guide.md §4). 32+ random hex chars.
CRON_SECRET=replace-with-32+chars-random

# --- CORS allowlist (comma-separated) ---
ALLOWED_ORIGINS=http://localhost:5173,https://profiley.ai,https://*.profiley.pages.dev

# --- Storage bucket names (must match SQL migration) ---
BUCKET_USER_UPLOADS=user_uploads
BUCKET_AVATARS=avatars
BUCKET_DOCUMENTS=documents

# --- Feature flags (server) ---
ENABLE_PUBLIC_CHAT=true
ENABLE_JOB_FIT=true
ENABLE_AVATAR_FOUNDATION=false
ENABLE_CITATIONS=true
ENABLE_VOICE=false
ENABLE_CLAIM_VALIDATION_PASS=false

# --- Observability ---
SENTRY_DSN_EDGE=
LOG_LEVEL=info                                   # trace | debug | info | warn | error
