# =============================================================================
# Supabase CLI — local linking & db push
# =============================================================================
# Used by the `supabase` CLI for project linking, db push, and secrets sync.
# Copy to `supabase/.env` (gitignored). Not consumed by edge functions at
# runtime — those use supabase/functions/.env.example.
# =============================================================================

SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_PROJECT_REF_DEV=
SUPABASE_PROJECT_REF_PROD=
SUPABASE_DB_PASSWORD_DEV=
SUPABASE_DB_PASSWORD_PROD=
