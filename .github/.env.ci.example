# =============================================================================
# CI / GitHub Actions — repository secrets reference
# =============================================================================
# Not consumed at runtime. Use this list when configuring repo secrets at
# GitHub → Settings → Secrets and variables → Actions.
# =============================================================================

# --- Supabase CLI (db push, secrets sync) ---
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_PROJECT_REF_DEV=
SUPABASE_PROJECT_REF_PROD=
SUPABASE_DB_PASSWORD_DEV=
SUPABASE_DB_PASSWORD_PROD=

# --- Cloudflare Pages deploy (used by `wrangler` locally and GitHub Actions) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Two Cloudflare Pages projects, one per Supabase environment.
CLOUDFLARE_PAGES_PROJECT_DEV=profiley-dev
CLOUDFLARE_PAGES_PROJECT_PROD=profiley
